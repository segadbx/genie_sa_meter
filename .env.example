# Example environment file. Copy to .env and fill in — .env is git-ignored.
#
# Credentials come from the environment, a Databricks profile, or a secret manager.
# Do NOT put credentials in config.yaml.

# --- Databricks authentication (choose ONE approach) ---
# Option A: rely on a named profile in ~/.databrickscfg (set databricks_profile in config).
# Option B: environment-based auth (set use_default_auth: true in config), e.g.:
# DATABRICKS_HOST="https://<workspace>.cloud.databricks.com"
# DATABRICKS_TOKEN="<set via secret manager; never commit>"

# --- Optional config overrides (GENIE_BENCHMARK_<FIELD>) ---
# GENIE_BENCHMARK_GENIE_SPACE_ID="..."
# GENIE_BENCHMARK_EXPERIMENT_ID="..."
# GENIE_BENCHMARK_ENVIRONMENT="customer-session-1"

# --- Opt-in integration tests ---
# GENIE_BENCHMARK_INTEGRATION="1"
# GENIE_BENCHMARK_INTEGRATION_CONFIG="config.yaml"
